# Server only. Configure actual values through the approved environment setup.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM private key with real newlines, not a NEXT_PUBLIC variable.
GITHUB_APP_PRIVATE_KEY=
# Random secret with at least 32 characters; use a different value per environment.
GITHUB_SESSION_SECRET=

# Vercel Integration: Projects and Deployments scopes, Read only.
VERCEL_INTEGRATION_CLIENT_ID=
VERCEL_INTEGRATION_CLIENT_SECRET=
VERCEL_INTEGRATION_SLUG=
# Supabase Platform OAuth app: Projects scope, Read only (not Supabase Auth).
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
